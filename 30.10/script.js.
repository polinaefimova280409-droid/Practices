const siteA = ['anna', 'ivan', 'anna', 'petr', 'olga'];
const siteB = ['ivan', 'anna', 'sergey', 'olga', 'ivan'];

const setA = new Set(siteA);
console.log("Set на основе siteA:", setA); 

console.log("Количество уникальных пользователей A:", setA.size); 

console.log("Заходил ли petr на сайт A:", setA.has('petr')); 

const allVisitors = new Set([...siteA, ...siteB]);

const finalArray = [...allVisitors];
console.log("Итоговый массив:", finalArray);
